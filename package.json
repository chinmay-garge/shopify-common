{
  "name": "shopify-common",
  "description": "Sandbox shared theme — mirrors the multi-site Shopify CI/CD architecture for testing",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "release": "./release.sh",
    "dev:a": "npm-run-all -p tailwind:watch esbuild:watch shopify:dev -- --store 0fjhbq-rs",
    "dev:b": "npm-run-all -p tailwind:watch esbuild:watch shopify:dev -- --store m3cfzx-rp",
    "dev:c": "npm-run-all -p tailwind:watch esbuild:watch shopify:dev -- --store kydspe-qt",
    "push:a": "npm run build && npm run shopify:push -- --store 0fjhbq-rs",
    "push:b": "npm run build && npm run shopify:push -- --store m3cfzx-rp",
    "push:c": "npm run build && npm run shopify:push -- --store kydspe-qt",
    "pull:a": "npm run shopify:pull -- --store 0fjhbq-rs",
    "pull:b": "npm run shopify:pull -- --store m3cfzx-rp",
    "pull:c": "npm run shopify:pull -- --store kydspe-qt",
    "purge": "rm -f ./theme/assets/*.vbt.*",
    "build": "npm run tailwind:compile && npm run esbuild:bundle",
    "esbuild:watch": "node build.js",
    "esbuild:bundle": "node build.js --bundle",
    "shopify:dev": "shopify theme dev --port=9333 --path ./theme/",
    "shopify:push": "shopify theme push --path ./theme/",
    "shopify:pull": "shopify theme pull --path ./theme/",
    "tailwind:compile": "npx @tailwindcss/cli -i ./src/tailwind.config.css -o ./theme/assets/global.vbt.css",
    "tailwind:watch": "npx @tailwindcss/cli -i ./src/tailwind.config.css -o ./theme/assets/global.vbt.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.8",
    "esbuild": "^0.24.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.8"
  }
}
