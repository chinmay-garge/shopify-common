{%- comment -%}
  Sandbox section 4 of 10 — DIVERGENCE TEST.
  This file is deliberately given a DIFFERENT body in site-b's repo, to
  reproduce the "same filename, divergent content" collision we hit with
  skinstylus. shopify-common's version is the source of truth: drift
  detection should flag site-b, and a deploy should overwrite site-b's copy.

  Marker below is what we assert on: COMMON-VERSION.
{%- endcomment -%}

{% liquid
  assign s = section.settings
%}

<div
  class="sandbox-banner"
  data-sandbox-origin="COMMON-VERSION"
  style="padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px; background: {{ s.background }};"
>
  {%- if s.heading != blank -%}
    <h2 class="sandbox-banner__heading">{{ s.heading }}</h2>
  {%- endif -%}

  {%- if s.subheading != blank -%}
    <p class="sandbox-banner__subheading">{{ s.subheading }}</p>
  {%- endif -%}

  {%- if s.dismissible -%}
    <button class="sandbox-banner__dismiss" type="button" aria-label="Dismiss">&times;</button>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.sandbox-banner.name",
  "tag": "section",
  "class": "sandbox-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.sandbox-banner.settings.heading", "default": "Sandbox banner" },
    { "type": "text", "id": "subheading", "label": "t:sections.sandbox-banner.settings.subheading" },
    { "type": "color", "id": "background", "label": "t:sections.sandbox-banner.settings.background", "default": "#f4f4f4" },
    { "type": "checkbox", "id": "dismissible", "label": "t:sections.sandbox-banner.settings.dismissible", "default": false },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.sandbox-banner.settings.padding_top", "default": 24 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.sandbox-banner.settings.padding_bottom", "default": 24 }
  ],
  "presets": [{ "name": "t:sections.sandbox-banner.name" }]
}
{% endschema %}
