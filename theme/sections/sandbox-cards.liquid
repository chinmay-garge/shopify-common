{%- comment -%}
  Sandbox section 2 of 10 — BASELINE (identical across all sites).
  Also exercises block-based sections in the deploy/diff pipeline.
{%- endcomment -%}

{% liquid
  assign s = section.settings
%}

<div class="sandbox-cards" style="padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;">
  {%- if s.heading != blank -%}
    <h2 class="sandbox-cards__heading">{{ s.heading }}</h2>
  {%- endif -%}

  <div class="sandbox-cards__grid">
    {%- for block in section.blocks -%}
      <div class="sandbox-cards__card" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'sandbox-cards__image' }}
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <h3 class="sandbox-cards__title">{{ block.settings.title }}</h3>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class="sandbox-cards__text">{{ block.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.sandbox-cards.name",
  "tag": "section",
  "class": "sandbox-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.sandbox-cards.settings.heading", "default": "Sandbox cards" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.sandbox-cards.settings.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.sandbox-cards.settings.padding_bottom", "default": 40 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:sections.sandbox-cards.blocks.card.name",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.sandbox-cards.blocks.card.settings.image" },
        { "type": "text", "id": "title", "label": "t:sections.sandbox-cards.blocks.card.settings.title", "default": "Card title" },
        { "type": "richtext", "id": "text", "label": "t:sections.sandbox-cards.blocks.card.settings.text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.sandbox-cards.name",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
