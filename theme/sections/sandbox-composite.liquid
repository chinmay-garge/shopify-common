{%- comment -%}
  Sandbox section 10 of 10 — DEPENDENCY + BUILD OUTPUT TEST.

  Depends on two things that must travel with it:
    1. snippets/sandbox-badge.liquid  (a snippet dependency)
    2. assets/global.vbt.js           (esbuild output, generated by npm run build)

  This is the fixture for two failure modes:
    - Porting a section without its snippet dependency (broken render).
    - Deploying without running the build first (missing .vbt. asset -> the
      asset_url below resolves to nothing).
{%- endcomment -%}

{% liquid
  assign s = section.settings
%}

<div class="sandbox-composite" data-sandbox-composite style="padding: {{ s.padding }}px 20px;">
  {%- if s.heading != blank -%}
    <h2 class="sandbox-composite__heading">{{ s.heading }}</h2>
  {%- endif -%}

  <div class="sandbox-composite__items">
    {%- for block in section.blocks -%}
      <div class="sandbox-composite__item" {{ block.shopify_attributes }}>
        {% render 'sandbox-badge', label: block.settings.badge_label, tone: block.settings.badge_tone %}
        {%- if block.settings.text != blank -%}
          <div class="sandbox-composite__text">{{ block.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.sandbox-composite.name",
  "tag": "section",
  "class": "sandbox-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.sandbox-composite.settings.heading", "default": "Sandbox composite" },
    { "type": "range", "id": "padding", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.sandbox-composite.settings.padding", "default": 32 }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.sandbox-composite.blocks.item.name",
      "settings": [
        { "type": "text", "id": "badge_label", "label": "t:sections.sandbox-composite.blocks.item.settings.badge_label", "default": "New" },
        {
          "type": "select",
          "id": "badge_tone",
          "label": "t:sections.sandbox-composite.blocks.item.settings.badge_tone",
          "options": [
            { "value": "neutral", "label": "t:sections.sandbox-composite.blocks.item.settings.badge_tone_options.neutral" },
            { "value": "accent", "label": "t:sections.sandbox-composite.blocks.item.settings.badge_tone_options.accent" }
          ],
          "default": "neutral"
        },
        { "type": "richtext", "id": "text", "label": "t:sections.sandbox-composite.blocks.item.settings.text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.sandbox-composite.name",
      "blocks": [{ "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
