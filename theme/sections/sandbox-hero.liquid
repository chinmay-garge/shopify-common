{%- comment -%}
  Sandbox section 1 of 10 — BASELINE (identical across all sites).
  Purpose: prove that shared code deploys byte-identically to every site.
{%- endcomment -%}

{% liquid
  assign s = section.settings
%}

<div class="sandbox-hero" data-j6-marker="deploy-durability-test" style="padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;">
  <div class="sandbox-hero__inner">
    {%- if s.eyebrow != blank -%}
      <p class="sandbox-hero__eyebrow">{{ s.eyebrow }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      {%- if s.use_h1 -%}
        <h1 class="sandbox-hero__heading">{{ s.heading }}</h1>
      {%- else -%}
        <h2 class="sandbox-hero__heading">{{ s.heading }}</h2>
      {%- endif -%}
    {%- endif -%}

    {%- if s.body != blank -%}
      <div class="sandbox-hero__body">{{ s.body }}</div>
    {%- endif -%}

    {%- if s.cta_label != blank and s.cta_url != blank -%}
      <a class="sandbox-hero__cta button" href="{{ s.cta_url }}">{{ s.cta_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.sandbox-hero.name",
  "tag": "section",
  "class": "sandbox-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.sandbox-hero.settings.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:sections.sandbox-hero.settings.heading", "default": "Sandbox hero" },
    { "type": "richtext", "id": "body", "label": "t:sections.sandbox-hero.settings.body" },
    { "type": "checkbox", "id": "use_h1", "label": "t:sections.sandbox-hero.settings.use_h1", "default": false },
    { "type": "text", "id": "cta_label", "label": "t:sections.sandbox-hero.settings.cta_label" },
    { "type": "url", "id": "cta_url", "label": "t:sections.sandbox-hero.settings.cta_url" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.sandbox-hero.settings.padding_top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.sandbox-hero.settings.padding_bottom", "default": 40 }
  ],
  "presets": [{ "name": "t:sections.sandbox-hero.name" }]
}
{% endschema %}
