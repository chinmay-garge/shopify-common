{%- comment -%}
  Sandbox section 8 of 10 — MISSING TRANSLATION BUG REPRO.

  The t: keys below are DELIBERATELY absent from
  theme/locales/en.default.schema.json. In the theme editor this renders as
  "missing translation: t:sections.sandbox-promo.name" — exactly the bug hit
  when comparison-table was ported without its locale keys.

  This also proves the second half of that bug: because both deploy workflows
  ignore locales/*.json, adding the keys to git does NOT fix the live theme.
  Only sync-locales.yml (or a manual --only locales push) does.

  DO NOT add these keys to the locale file — this section is the regression
  fixture for the locale-sync gap.
{%- endcomment -%}

{% liquid
  assign s = section.settings
%}

<div class="sandbox-promo" style="padding: {{ s.padding }}px 20px; background: {{ s.background }};">
  {%- if s.heading != blank -%}
    <h2 class="sandbox-promo__heading">{{ s.heading }}</h2>
  {%- endif -%}

  {%- if s.code != blank -%}
    <p class="sandbox-promo__code">{{ s.code }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.sandbox-promo.name",
  "tag": "section",
  "class": "sandbox-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.sandbox-promo.settings.heading", "default": "Sandbox promo" },
    { "type": "text", "id": "code", "label": "t:sections.sandbox-promo.settings.code", "default": "SANDBOX10" },
    { "type": "color", "id": "background", "label": "t:sections.sandbox-promo.settings.background", "default": "#fff8e1" },
    { "type": "range", "id": "padding", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "t:sections.sandbox-promo.settings.padding", "default": 24 }
  ],
  "presets": [{ "name": "t:sections.sandbox-promo.name" }]
}
{% endschema %}
